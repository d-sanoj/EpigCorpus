# Python-generated files
__pycache__/
*.py[oc]
*.pyo
*.pyd
*.so
build/
dist/
wheels/
*.egg-info
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv
venv/

# IDE/editor
.vscode/
.idea/

# OS
.DS_Store

# Scraper runtime artifacts
data/raw/harvest/edcs_checkpoint.json

# Corpus snapshots: commit the COMPRESSED form, ignore the working copies.
# The scraper writes plain .jsonl/.tsv and compresses them on completion; the
# loaders read either, so a fresh clone works from the .gz with no manual step.
data/raw/*.jsonl
data/raw/*.tsv
data/processed/*.jsonl
data/processed/*.tsv
data/processed/edcs_inscriptions_cleaned.csv
!data/raw/*.jsonl.gz
!data/raw/*.tsv.gz
!data/processed/*.jsonl.gz
!data/processed/*.tsv.gz

# Derived caches — regenerated on demand, not worth versioning
data/raw/harvest/edcs_index_cache.json

# Small metadata files below are committed deliberately:
#   data/reference/edcs_lookup.json           code tables for the harvest
#   data/raw/harvest/edcs_harvest_manifest.json completion record
#   data/raw/harvest/edcs_failed_ids.json       failure manifest

# Derived pair tables. Same convention as the corpus snapshots above: commit
# the COMPRESSED form, ignore the plain working copy. The plain .tsv is
# 140-210 MB (above GitHub's 100 MB hard limit); gzipped it is 23-28 MB.
# Both are regenerated deterministically by scripts/abbrev_probe.py and
# scripts/phase3_build_v1.py.
data/processed/derived/**/*.tsv
data/processed/derived/*.tsv
!data/processed/derived/**/*.tsv.gz
!data/processed/derived/*.tsv.gz

# Parquet snapshot of the cleaned corpus: rebuilt from the JSONL whenever the
# JSONL changes, so not versioned.
data/processed/*.parquet
data/processed/*.parquet.partial

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
